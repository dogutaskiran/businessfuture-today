{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/newsletter/unsubscribe/:token",
      "destination": "/newsletter/unsubscribe/?token=:token",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/media/:path*",
      "destination": "https://pub-bee1ccae8444499fb2a74842fcf63f2b.r2.dev/media/:path*"
    },
    {
      "source": "/articles/:path*",
      "destination": "https://pub-bee1ccae8444499fb2a74842fcf63f2b.r2.dev/articles/:path*"
    }
  ]
}
